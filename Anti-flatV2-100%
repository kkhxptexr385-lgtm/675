-- ===== LAYER 7: HEARTBEAT SPEED CHECK =====
_RS.Heartbeat:Connect(function()
    if not AC.Enabled or not _LP.Character then return end
    local hrp = _LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local now = tick()
    local dt = now - AC.LastTick
    if dt >= 0.1 then
        if AC.LastPos then
            local dist = (hrp.Position - AC.LastPos).Magnitude
            local speed = dist / dt
            local check = _real.checkcaller and _real.checkcaller() or false
            if speed > AC.MaxSpeed and not check then
                pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
            end
        end
        AC.LastPos, AC.LastTick = hrp.Position, now
    end
end)

