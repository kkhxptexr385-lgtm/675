local AC = {
    Enabled = true,
    MaxSpeed = 120,
    RemoteLimit = 35,
    RemoteHardCap = 4,
    Calls = {},
    LastPos = nil,
    LastTick = tick(),
    Violations = 0
}

local blockedW = {
    "ban","kick","exploit","cheat","suspicious","violation",
    "block","detected","flagged","report","hack","bypass"
}
local function isBlocked(s)
    if type(s) ~= "string" then return false end
    local l = string.lower(s)
    for _, w in ipairs(blockedW) do
        if l:find(w) then return true end
    end
    return false
end

-- ===== LAYER 4: METATABLE HOOK =====
pcall(function()
    if not _real.getrawmetatable then return end
    local mt = _real.getrawmetatable(game)
    if not mt then return end
    if _real.setreadonly then _real.setreadonly(mt, false) end

    local oldNC = mt.__namecall
    local oldIX = mt.__index

    if oldNC and _real.newcclosure then
        mt.__namecall = _real.newcclosure(function(self, ...)
            local m = _real.getnamecallmethod and _real.getnamecallmethod() or ""
            local callerCheck = _real.checkcaller and _real.checkcaller() or false

            if AC.Enabled and not callerCheck then
                if m == "Kick" then
                    local args = {...}
                    if isBlocked(args[1]) then
                        AC.Violations = AC.Violations + 1
                        return false
                    end
                end

                if (m == "FireServer" or m == "InvokeServer") and typeof(self) == "Instance" then
                    local rn = tostring(self.Name or tostring(self))
                    local now = tick()
                    AC.Calls[rn] = AC.Calls[rn] or {}
                    local c = AC.Calls[rn]

                    for i = #c, 1, -1 do
                        if now - c[i] > 1 then table.remove(c, i) end
                    end

                    if #c >= AC.RemoteHardCap then return nil end
                    if #c >= AC.RemoteLimit then return nil end

                    for _, a in ipairs({...}) do
                        if isBlocked(a) then return nil end
                    end

                    table.insert(c, now)
                end

                if m == "FindFirstChild" or m == "GetAttribute" then
                    local a1 = ...
                    if a1 == "WalkSpeed" or a1 == "Speed" then return 16
                    elseif a1 == "JumpPower" or a1 == "JumpHeight" then return 50 end
                end
            end

            return oldNC(self, ...)
        end)
    end

    if oldIX and _real.newcclosure then
        mt.__index = _real.newcclosure(function(self, k)
            if AC.Enabled and not (_real.checkcaller and _real.checkcaller()) then
                if typeof(self) == "Instance" and self:IsA("Humanoid") then
                    if k == "WalkSpeed" then return 16
                    elseif k == "JumpPower" or k == "JumpHeight" then return 50
                    elseif k == "HipHeight" then return 2 end
                end
            end
            return oldIX(self, k)
        end)
    end

    if _real.setreadonly then _real.setreadonly(mt, true) end
end)

